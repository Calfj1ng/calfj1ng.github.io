---
// src/pages/daily/[...slug].astro
// 「每日学习」单篇页面。文章正文被 DailyLayout 加密，浏览器端密码解锁。
// 注意：传给 DailyLayout 的 title 是页面级 <title>（用于浏览器标签页），
// 这里故意用通用「每日学习」而非文章真实标题，避免在标签页/meta 里泄露标题。
import { type CollectionEntry, getCollection, render } from 'astro:content';
import DailyLayout from '../../layouts/DailyLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('daily');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'daily'>;

const post = Astro.props;
const { Content } = await render(post);
---

<DailyLayout title="每日学习 | Calfjing的小世界" description="每日学习记录">
  <article class="daily-post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <FormattedDate date={post.data.pubDate} />
        {post.data.updatedDate && (
          <span class="updated">
            （更新于 <FormattedDate date={post.data.updatedDate} />）
          </span>
        )}
      </div>
      {post.data.tags && (
        <div class="tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="post-content">
      <Content />
    </div>
    <div class="back-link">
      <a href="/daily/">← 返回每日学习</a>
    </div>
  </article>
</DailyLayout>

<style>
  .daily-post {
    max-width: 48rem;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header h1 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--accent-light);
    color: var(--accent);
    padding: 0.2em 0.7em;
    border-radius: 999px;
    font-size: 0.8rem;
  }

  .post-content {
    line-height: 1.8;
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .back-link {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .back-link a {
    color: var(--accent);
    font-size: 0.95rem;
  }
</style>
